{
  "name": "@kervan/studio",
  "version": "0.1.0",
  "private": true,
  "description": "Kervan Studio: a self-hosted web app for writing, publishing and serving kervan.yaml MCP servers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.23.3 || >=24.21.0"
  },
  "bin": {
    "kervan-studio": "./bin/kervan-studio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@kervan/core": "workspace:^",
    "@kervan/spec-runtime": "workspace:^",
    "@kervan/transport": "workspace:^",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "1.64.0",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.0",
    "@radix-ui/react-select": "2.4.0",
    "@radix-ui/react-tabs": "1.2.0",
    "@radix-ui/react-tooltip": "1.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "lucide-react": "1.55.0",
    "monaco-editor": "0.52.2",
    "monaco-yaml": "^5.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "vite": "^8.3.4"
  }
}
